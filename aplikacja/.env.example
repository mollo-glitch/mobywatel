# Wzór ustawień lokalnego serwera projektu (server/serwer-lokalny.mjs).
# Skopiuj do pliku .env w tym samym katalogu i uzupełnij. Plik .env jest w .gitignore: nie dodawaj go do repozytorium.
# Sekrety zostają na serwerze: nie trafiają do przeglądarki, HTML, odpowiedzi API ani logów.
# Puste pola dostępu = model AI wyłączony: asystent mówi wprost, że AI nie jest podłączone, i nic nie wysyła.

# --- Dostawca: workers-ai (zalecany) albo gemini. Puste = wybór według uzupełnionych pól poniżej.
AI_PROVIDER=

# --- Cloudflare Workers AI (ten sam model co w funkcji serwerowej). Konto Cloudflare na planie Workers Free.
# Identyfikator konta: panel Cloudflare → Workers AI → „Use REST API”.
# Token: My Profile → API Tokens → Create Token → szablon „Workers AI” (uprawnienia Workers AI: Read i Edit).
CF_ACCOUNT_ID=
CF_API_TOKEN=
# Model z katalogu Workers AI dostępny w planie Free.
AI_MODEL=@cf/google/gemma-4-26b-a4b-it

# --- Gemini API (tylko lokalne testy autora). Bezpłatny poziom: Google może używać treści do ulepszania usług,
# a aplikacji udostępnianej w EOG nie wolno obsługiwać bezpłatnym poziomem. Nie używaj go na publicznej stronie.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PLAN=free

# Adres serwera. Zostaw 127.0.0.1 (tylko ten komputer).
HOST=127.0.0.1
PORT=8080

# Limity po stronie serwera prototypu (niższe niż limity dostawcy; te ustala dostawca i może je zmienić).
AI_MAX_PER_MINUTE=6
AI_MAX_PER_DAY=150

# Ile milisekund czekać na odpowiedź modelu (potem asystent mówi, że model nie odpowiedział).
AI_TIMEOUT_MS=20000

# Wzór ustawień lokalnego serwera projektu (server/gemini-adapter.mjs).
# Skopiuj do pliku .env w tym samym katalogu i uzupełnij. Plik .env jest w .gitignore: nie dodawaj go do repozytorium.
# Klucz zostaje na serwerze: nie trafia do przeglądarki, HTML, odpowiedzi API ani logów.

# Klucz z Google AI Studio. Projekt bez konta rozliczeniowego = bezpłatny poziom (tylko lokalne testy autora).
# Puste pole = model AI wyłączony: asystent mówi wprost, że AI nie jest podłączone, i nic nie wysyła.
GEMINI_API_KEY=

# Model Gemini. Domyślny poniżej; jeśli serwer zgłosi „model jest niedostępny”, wpisz model z listy w AI Studio.
GEMINI_MODEL=gemini-3.1-flash-lite

# free = bezpłatny poziom; paid = projekt z aktywnym kontem rozliczeniowym (wymagane, gdy aplikację widzą użytkownicy w EOG).
GEMINI_PLAN=free

# Adres serwera. Zostaw 127.0.0.1 (tylko ten komputer): bezpłatny poziom służy do lokalnych testów i pokazu.
HOST=127.0.0.1
PORT=8080

# Limity po stronie serwera prototypu, celowo niższe niż limity bezpłatnego poziomu (te ustala Google i może je zmienić).
AI_MAX_PER_MINUTE=8
AI_MAX_PER_DAY=200

# Ile milisekund czekać na odpowiedź modelu (potem asystent mówi, że model nie odpowiedział).
GEMINI_TIMEOUT_MS=12000
